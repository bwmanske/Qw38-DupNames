# GenerateBuildInfo.cmake
#
# Writes build_info.hpp and build_info.cpp into BUILD_INFO_DIR, embedding the
# current date and time (the moment the build command was run). Invoked by
# CMake at configure time (to create the initial files) and on every build via
# the gen_build_info custom target (so the stamp is refreshed on each build,
# even when only unrelated inputs such as the icon change).
#
# Usage: cmake -DBUILD_INFO_DIR=<dir> -P GenerateBuildInfo.cmake

if(NOT DEFINED BUILD_INFO_DIR)
  message(FATAL_ERROR "GenerateBuildInfo.cmake: BUILD_INFO_DIR must be set")
endif()

string(TIMESTAMP DN_BUILD_DATE "%b %d %Y")   # e.g. "Nov 24 2026"
string(TIMESTAMP DN_BUILD_TIME "%H:%M:%S")   # e.g. "14:35:22"

file(WRITE "${BUILD_INFO_DIR}/build_info.hpp"
"#pragma once

// Generated by CMake at build time (cmake/GenerateBuildInfo.cmake). Do not edit.
namespace dn {
const char* build_date();  // e.g. \"Nov 24 2026\"
const char* build_time();  // e.g. \"14:35:22\"
}  // namespace dn
")

file(WRITE "${BUILD_INFO_DIR}/build_info.cpp"
"#include \"build_info.hpp\"

// Generated by CMake at build time (cmake/GenerateBuildInfo.cmake). Do not edit.
namespace dn {
const char* build_date() { return \"${DN_BUILD_DATE}\"; }
const char* build_time() { return \"${DN_BUILD_TIME}\"; }
}  // namespace dn
")
